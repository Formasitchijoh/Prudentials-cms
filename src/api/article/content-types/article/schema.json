{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Create your blog content"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "description": {
      "type": "text"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "articles"
    },
    "url": {
      "type": "text"
    },
    "section": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "News",
        "History",
        "Culture"
      ]
    },
    "tag": {
      "type": "enumeration",
      "enum": [
        "Today",
        "Opinion",
        "Africa",
        "World",
        "Finance & Economics",
        "North",
        "Central",
        "East",
        "West",
        "South",
        "Diaspora"
      ]
    },
    "isVideo": {
      "type": "boolean",
      "default": false
    },
    "youtubeUrl": {
      "type": "text"
    }
  }
}
